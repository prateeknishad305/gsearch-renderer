PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# auto | system | sparticuz
CHROMIUM_SOURCE=auto
# CHROMIUM_PATH=/usr/bin/chromium

BROWSER_REUSE=1
BROWSER_IDLE_MS=120000
MAX_CONTEXTS=4
BROWSER_WORKERS=4
CACHE_TTL_MS=300000
CACHE_MAX=500
SERPER_RENDER=0

# When the requested engine cannot be fetched (block/anti-bot/timeout on this
# network), transparently try the next engine instead of returning no results.
# Set AUTO_FALLBACK=0 to disable, or reorder the chain with AUTO_FALLBACK_ENGINES.
AUTO_FALLBACK=1
# AUTO_FALLBACK_ENGINES=duckduckgo,bing,wikipedia,archive,github,wiby,brave,yahoo,startpage,marginalia,mojeek,ecosia,qwant,yandex,google

# Drop non-organic garbage from Google SERPs. Video results (YouTube et al.) and
# AI Mode / AI Overview chrome are removed by default. Set to 0 to keep them.
FILTER_VIDEO=1
FILTER_AI_MODE=1
# Drop social/UGC hosts (default on) and developer/tutorial hosts (default off).
# Per-request overrides: ?unique=1 (social+dev+ugc+forum+blog),
# ?exclude=social,dev,ugc,forum,blog  ?social=0  ?dev=1  ?ugc=1  ?forum=1  ?blog=1
FILTER_SOCIAL=1
FILTER_DEV=0
FILTER_UGC=0
FILTER_FORUM=0
FILTER_BLOG=0

# Enrich shodan results with official Shodan InternetDB (free, no API key).
# Adds ports/hostnames/cpes/tags/vulns to each result.host. Set to 0 to skip.
INTERNETDB=1
INTERNETDB_TIMEOUT=4000
INTERNETDB_CONCURRENCY=3

MAX_RETRIES=0
NAVIGATION_TIMEOUT=7000
RESULT_TIMEOUT=2500
REQUEST_TIMEOUT=9000
PROXY_SERVER=

# API_TOKEN=change-me
# PROXY_POOL=http://user:pass@host:port
# PROXY_ATTEMPTS=8
# GOOGLE_PROXY_ATTEMPTS=8
# PROXY_RACE=4
# PROXY_FALLBACK_DIRECT=0
# GOOGLE_HOME_WARMUP=0
# GOOGLE_UDM=0
# GOOGLE_STICKY=1
# GOOGLE_STICKY_N=15
# GOOGLE_PAGE_PARALLEL=0
# GOOGLE_BLOCK_ASSETS=0
# GOOGLE_FOLLOW_GOTO=0
# GOOGLE_PREFER_HTTP=1
# GOOGLE_SKIP_SOCKS=1
# GOOGLE_PROBE_MS=400
# GOOGLE_NAV_MS=12000
# GOOGLE_READY_MS=8000
# GOOGLE_JITTER_MS=0
# GOOGLE_IP_FAILS=2
# GOOGLE_IP_COOLDOWN_MS=180000
# GOOGLE_NAV_PER_IP=1
# GOOGLE_GEO_FROM_PROXY=1
# GOOGLE_NCR=1
# GOOGLE_FAKE_CONSENT=1
# PROXY_FETCH=1
# PROXY_FETCH_URL=https://etherealproxyfetch.onrender.com/live.txt
# PROXY_LIVE_MIN=8
# PROXY_CHECK_MAX=30
# CRAWL_BUDGET_MS=50000
# USER_PROXY_MAX=10000

# --- Google lite transport -----------------------------------------------------
# Retry rounds for the plain-HTTP Google path. The Chromium fallback is only
# used on the last round, so a blocked IP costs one render per request.
# LITE_GOOGLE_ROUNDS=3
# Per-exit timeout for the plain-HTTP Google path.
# LITE_GOOGLE_TIMEOUT_MS=3500
# Fetch the next page when a page returns fewer hits than requested, so num=10
# really returns 10 results.
# LITE_TOPUP=1
# LITE_TOPUP_SLACK=1
# On a cold start, how long to wait for the live proxy list.
# LITE_POOL_WARM_MS=2500
# Only keep proxy exits that can CONNECT to this host:port. The default check
# only proves a proxy is up, not that it can reach Google.
# PROXY_CHECK_TARGET=www.google.com:443
# --- Dorks (site:, filetype:, inurl:) -------------------------------------------
# A dork needs the modern Google surface, so its browser render is capped.
# The cap keeps the request budget free for the engines that honour the
# operator without a browser.
# LITE_DORK_CHROME_MS=6000
# How much of the request budget the primary engine may use for a dork.
# LITE_DORK_ENGINE_MS=8000
# How often an engine that answered without a single on-target hit is retried
# on another exit before it is given up on.
# DORK_RETRIES=2
# Budget kept for a fallback engine that has not run yet.
# FALLBACK_RESERVE_MS=3000
# Attach Google Suggest and Google News to Google results.
# GOOGLE_ENRICH=1
# GOOGLE_SUGGEST=1
# GOOGLE_NEWS=1
# GOOGLE_SUGGEST_MS=2500
# GOOGLE_NEWS_MS=4000
# GOOGLE_SUGGEST_LIMIT=10
# GOOGLE_NEWS_LIMIT=10
# Exits rendered in parallel by the Chromium fallback.
# CHROME_FETCH_WORKERS=2
