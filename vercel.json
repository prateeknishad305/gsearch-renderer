{
  "version": 2,
  "functions": {
    "api/search.js": { "maxDuration": 60, "memory": 1024 },
    "api/batch.js": { "maxDuration": 60, "memory": 1024 },
    "api/serper.js": { "maxDuration": 60, "memory": 1024 },
    "api/crawl.js": { "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/search" },
    { "source": "/search", "destination": "/api/search" },
    { "source": "/serper", "destination": "/api/serper" },
    { "source": "/api/google/search", "destination": "/api/serper" },
    { "source": "/batch", "destination": "/api/batch" },
    { "source": "/crawl", "destination": "/api/crawl" },
    { "source": "/proxies", "destination": "/api/proxies" },
    { "source": "/engines", "destination": "/api/engines" },
    { "source": "/stats", "destination": "/api/stats" },
    { "source": "/health", "destination": "/api/health" }
  ]
}
